
%config {
    import-dbg = false;
    system-signals = [ 17 ];

    // SAHTRACE
    sahtrace = {
        type = "syslog",
        level = 200
    };

    prefix_file = "/etc/amx/cwmp_plugin/cwmp_plugin-prefix.odl";

    // tr069 service configuration
    tr069-service = {
        // Path where to store temporary values for RPC's that need to survive a reboot
        cwmpd_persistent_rpc_path = "/etc/config/cwmp_plugin",
        cwmpd_pid_file = "/var/run/cwmp.pid",
        cwmpd_certs_file = "/usr/share/ca-certificates/ca.crt",

        // A path name of a row in the Security.Certificate table.
        // If specified, cwmpd_client_certs and cwmpd_client_privatekey will be ignored
        cwmpd_certificate = "Security.Certificate.2.",

        // Deprecated, use cwmpd_certificate instead
        cwmpd_client_certs = "",

        // Deprecated, use cwmpd_certificate instead
        cwmpd_client_privatekey = "",

        cwmpd_adapter_path = "/usr/lib/libdmda_amx.so",
        cwmpd_acl_file = "/cfg/etc/acl/merged/cwmp.json"
    };

    cwmpd_backend = "/usr/bin/mods/amxb/mod-amxb-ubus.so";
    cwmpd_uri = "ubus:/var/run/ubus/ubus.sock";

    trace-zones = {
        CWMPD = 200,
        DM_DA = 200,
        DM_ENGINE = 200,
        DM_COM = 200,
        DM_COMMON = 200,
        DM_HS = 200
    };
}
