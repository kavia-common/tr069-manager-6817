%define {
  /**
    * Datamodel definition written using TR181 spec Issue 2 Amendment 14 (November 2020)
    */

  /**
    * This object contains parameters relating to the CPE's association with an ACS.
    */
    %persistent object ManagementServer {
      /** Enables and disables the CPE's support for CWMP.
        * false means that CWMP support in the CPE is disabled, in which case the device MUST NOT send any Inform messages to the ACS or accept any Connection Request notifications from the ACS.
        * true means that CWMP support on the CPE is enabled.
        * The subscriber can re-enable the CPE's CWMP support either by performing a factory reset or by using a LAN-side protocol to change the value of this parameter back to true.
        * The factory default value MUST be true.
        * @version 1.0
        */
        %persistent bool EnableCWMP=1 {
            userflags %upc;
        }

      /**
        * The [URL] for the CPE to connect to the ACS using the CPE WAN Management Protocol.
        * This parameter MUST be in the form of a valid HTTP or HTTPS URL.
        * The host portion of this URL is used by the CPE for validating the ACS certificate when using SSL or TLS.
        * Note that on a factory reset of the CPE, the value of this parameter might be reset to its factory value.
        * If an ACS modifies the value of this parameter, it SHOULD be prepared to accommodate the situation that the original value is restored as the result of a factory reset.
        * @version 1.0
        */
        %persistent string URL {
            default "http://acs-download.qacafe.com";
            userflags %upc;
        }

      /**
        * Username used to authenticate the CPE when making a connection to the ACS using the CPE WAN Management Protocol.
        * This username is used only for HTTP-based authentication of the CPE.
        * Note that on a factory reset of the CPE, the value of this parameter might be reset to its factory value. If an ACS modifies the value of this parameter, it SHOULD be prepared to accommodate the situation that the original value is restored as the result of a factory reset.
        * @version 1.0
        */
        %persistent string Username {
            on action validate call check_maximum 256;
            default "cdrouter";
            userflags %upc;
        }

      /**
        * Password used to authenticate the CPE when making a connection to the ACS using the CPE WAN Management Protocol.
        * This password is used only for HTTP-based authentication of the CPE.
        * Note that on a factory reset of the CPE, the value of this parameter might be reset to its factory value. If an ACS modifies the value of this parameter, it SHOULD be prepared to accommodate the situation that the original value is restored as the result of a factory reset.
        * When read, this parameter returns an empty string, regardless of the actual value.
        * @version 1.0
        */
        %persistent string Password {
            on action read call hide_value;
            on action validate call check_maximum 256;
            default "cdrouter";
            userflags %upc;
        }

      /**
        * Whether or not the CPE MUST periodically send CPE information to the ACS using the Inform method call.
        * @version 1.0
        */
        %persistent bool PeriodicInformEnable=1 {
            userflags %upc;
        }

      /**
        * The duration in seconds of the interval for which the CPE MUST attempt to connect with the ACS and call the Inform method if PeriodicInformEnable is True.
        * @version 1.0
        */
        %persistent uint32 PeriodicInformInterval {
            on action validate call check_minimum 1;
            default 432000;
            userflags %upc;
        }

      /**
        * An absolute time reference in UTC to determine when the CPE will initiate the periodic Inform method calls. Each Inform call MUST occur at this reference time plus or minus an integer multiple of the PeriodicInformInterval.
        * PeriodicInformTime is used only to set the "phase" of the periodic Informs. The actual value of PeriodicInformTime can be arbitrarily far into the past or future.
        * For example, if PeriodicInformInterval is 86400 (a day) and if PeriodicInformTime is set to UTC midnight on some day (in the past, present, or future) then periodic Informs will occur every day at UTC midnight. These MUST begin on the very next midnight, even if PeriodicInformTime refers to a day in the future.
        * The Unknown Time value defined in section 2.2 indicates that no particular time reference is specified. That is, the CPE MAY locally choose the time reference, and needs only to adhere to the specified PeriodicInformInterval.
        * If absolute time is not available to the CPE, its periodic Inform behavior MUST be the same as if the PeriodicInformTime parameter was set to the Unknown Time value.
        * @version 1.0
        */
        %persistent datetime PeriodicInformTime {
            userflags %upc;
        }

      /**
        * The number of Periodic InformResponses that are received.
        * @version 1.0
        */
        %protected uint32 PeriodicInformCounter {
            default 0;
        }

      /**
        * Indicates support of instance wildcards to the ACS
        * @version 1.0
        */
        %persistent bool InstanceWildcardsSupported=1 {
            userflags %upc;
        }

      /**
        * ParameterKey provides the ACS a reliable and extensible means to track changes made by the ACS. The value of ParameterKey MUST be equal to the value of the ParameterKey argument from the most recent successful SetParameterValues, AddObject, or DeleteObject method call from the ACS.
        * The CPE MUST set ParameterKey to the value specified in the corresponding method arguments if and only if the method completes successfully and no fault response is generated. If a method call does not complete successfully (implying that the changes requested in the method did not take effect), the value of ParameterKey MUST NOT be modified.
        * The CPE MUST only modify the value of ParameterKey as a result of SetParameterValues, AddObject, DeleteObject, or due to a factory reset. On factory reset, the
        * value of ParameterKey MUST be set to empty.
        * @version 1.0
        */
        %persistent string ParameterKey {
            userflags %upc;
        }

      /**
        * The name of the interface on which to listen for connection requests.
        * @version 1.0
        */
        %persistent %protected string Interface {
            default "Device.Logical.Interface.1.";
        }

      /**
        * HTTP URL, as defined in [8], for an ACS to make a Connection Request notification to the CPE.
        * In the form:
        * http://host:port/path
        * The "host" portion of the URL MAY be the IP address for the management interface of the CPE in lieu of a host name.
        * Note: If the host portion of the URL is a literal IPv6 address then it MUST be enclosed in square brackets (see [Section 3.2.2/RFC3986]).
        * @version 1.0
        */
        %read-only string ConnectionRequestURL;

      /**
        * Username used to authenticate an ACS making a Connection Request to the CPE.
        * @version 1.0
        */
        %persistent string ConnectionRequestUsername {
            on action validate call check_maximum 256;
            default "acs";
            userflags %upc;
        }

      /**
        * Password used to authenticate an ACS making a Connection Request to the CPE.
        * When read, this parameter returns an empty string, regardless of the actual value.
        * @version 1.0
        */
        %persistent string ConnectionRequestPassword {
            on action read call hide_value;
            on action validate call check_maximum 256;
            default "acs";
            userflags %upc;
        }

      /**
        * Update @ref UpdateConnRequestURL.
        * If update is true, automatic updates are disabled, see @ref ConnRequestURL
        * If update is true and host and port are provided, @ref ConnectionRequestURL is updated
        * @param update Enable/disable automatic URL updates
        * @param host Host to be used for URL
        * @param port Port number to be used for URL
        * @return void
        * @error EACCESS, errors related to getting objects, function_exec_failed, invalid_parameter
        * @version 1.0
        */
        void updateConnectionRequestURL(%in %mandatory bool update, %in string host, %in uint16 port);

      /**
        * Indicates whether or not the ACS will manage upgrades for the CPE. If True, the CPE SHOULD NOT use other means other than the ACS to seek out available upgrades. If False, the CPE MAY use other means for this purpose.
        * Note that an autonomous upgrade (reported via an "10 AUTONOMOUS TRANSFER COMPLETE" Inform Event code) SHOULD be regarded as a managed upgade if it is performed according to ACS-specified policy.
        * @version 1.0
        */
        %persistent bool UpgradesManaged=1;

      /**
        * This parameter is used to control throttling of active notifications sent by the CPE to the ACS. It defines the minimum number of seconds that the CPE MUST wait since the end of the last session with the ACS before establishing a new session for the purpose of delivering an active notification.
        * In other words, if CPE needs to establish a new session with the ACS for the sole purpose of delivering an active notification, it MUST delay establishing such a session as needed to ensure that the minimum time since the last session completion has been met.
        * The time is counted since the last successfully completed session, regardless of whether or not it was used for active notifications or other purposes. However, if connection to the ACS is established for purposes other than just delivering active notifications, including for the purpose of retrying a failed session, such connection MUST NOT be delayed based on this parameter value, and the pending active notifications MUSTbe communicated during that connection.
        * The time of the last session completion does not need to be tracked across reboots.
        * @version 1.0
        */
        %persistent uint32 DefaultActiveNotificationThrottle;

      /**
        * When true, the parameters type used in a SetParameterValues call will be validated.
        * @version 8.3
        */
        %persistent %protected bool VerifyParameterType {
          default true;
          userflags %upc;
        }

      /**
        * When true, the validation function in SetParameterValues will accept unsignedInt type parameters as boolean type parameters.
        * @version 8.4
        */
        %persistent %protected bool AcceptUnsignedIntAsBoolean {
          default false;
          userflags %upc;
        }

      /**
        * Indicates whether or not the Alias-Based Addressing Mechanism is supported.
        * A true value indicates that the CPE supports the Alias-Based Addressing Mechanism, as defined in [Section 3.6.1/TR-069] and described in [Appendix II/TR-069].     * @version 6.0
        * @version 1.0
        */
        %read-only bool AliasBasedAddressing = true;

      /**
        * Instance identification mode as defined in [Section 3.6.1/TR-069]. When AliasBasedAddressing is true, InstanceMode is used by the ACS to control whether the CPE will use Instance Numbers or Instance Aliases in returned Path Names. Enumeration of:
        * - InstanceNumber
        * - InstanceAlias
        * This parameter is REQUIRED for any CPE supporting Alias-Based Addressing.
        * The factory default value MUST be InstanceNumber.
        * @version 1.0
        */
        %persistent string InstanceMode {
            on action validate call check_enum ["InstanceNumber","InstanceAlias"];
            default "InstanceNumber";
        }

      /**
        * This parameter defines the time window in which MaxConnectionRequest may occur.
        * @version 1.0
        */
        %persistent uint32 "${vendor_prefix}FreqConnectionRequest" {
            on action validate call check_minimum 60;
            default 3600;
            userflags %upc;
        }

      /**
        * This parameter defines the maximum number of connection requests per FreqConnectionRequest.
        * @version 1.0
        */
        %persistent uint32 "${vendor_prefix}MaxConnectionRequest" {
            on action validate call check_minimum 1;
            default 50;
            userflags %upc;
        }        

      /**
        * Enable or disable the Auto-Create Instance Mechanism. When AliasBasedAddressing is true, AutoCreateInstances indicates whether or not the CPE will automatically create instances while processing a SetParameterValues RPC (as defined in [A.3.2.1/TR-069]).
        * - A true value indicates that the CPE will perform auto-creation of instances when the Alias-Based Addressing Mechanism is used in SetParameterValues RPC.
        * - A false value indicates that the CPE will not create new object instances. Instead, it will reject the setting of parameters in unrecognized instances and respond with a fault code.
        * This parameter is REQUIRED for any CPE supporting Alias-Based Addressing.
        * The factory default value MUST be false.
        * @version 1.0
        */
        %read-only bool AutoCreateInstances = false;

      /**
        * The minimum time, in seconds, between Active Notifications resulting from changes to the ManageableDeviceNumberOfEntries (if Active Notification is enabled).
        * @version 1.0
        */
        uint32 ManageableDeviceNotificationLimit;

      /**
        * The DSCP value, with a range from 0 to 63, used to prioritize traffic in a network (Qos).
        * Common DSCP values are:
        * - Best Effort (default): 0
        * - Assured Forwarding (AF) Classes : 10, 12, 14, 18, 20, 22, 26, 28, 30
        * - Expedited Forwarding (EF): 46
        * - Class Selector Values (Legacy TOS): 8, 16, 24, 32, 40, 48, 56
        * Will be converted to a TOS field and set as a socket option for both server and client side.
        * @version 8.4
        */
        %persistent %protected uint32 DSCP {
          default 0;
          on action validate call check_range [0,63];
          userflags %upc;
        }

      /**
        * Each entry in this table corresponds to a distinct LAN Device that supports Device-Gateway Association according to [Annex F/TR-069a2] as indicated by the presence of the DHCP option specified in that Annex.
        * @version 1.0
        */
        object ManageableDevice[] {
        /**
          * Alias for the instance
          * @version 1.0
          */
          %unique %key string Alias {
            on action validate call check_maximum 64;
          }

        /**
           * The number of entries in the ManageableDevice table.
           * @version 1.0
           */
          counted with ManageableDeviceNumberOfEntries;

        /**
          * Organizationally unique identifier of the Device manufacturer as provided to the Gateway by the Device. Represented as a six hexadecimal-digit 
          * value using all upper-case letters and including any leading zeros. Possible patterns:
          * @version 1.0
          */
          %read-only string ManufacturerOUI {
            on action validate call check_maximum 6;
          }

        /**
          * Serial number of the Device as provided to the Gateway by the Device.
          * @version 1.0
          */
          %read-only string SerialNumber {
            on action validate call check_maximum 64;
          }

        /**
          * Identifier of the class of product for which the Device's serial number applies as provided to the Gateway by the Device.
          * @version 1.0
          */
          %read-only string ProductClass {
            on action validate call check_maximum 64;
          }

        /**
          * Comma-separated list (maximum number of characters 1024) of strings. Each list item MUST be the Path Name of a row in the Hosts.Host table.
          * If the referenced object is deleted, the corresponding item MUST be removed from the list. References all the Hosts.Host table entries, 
          * whether active or inactive, that correspond to this physical LAN device. There can be multiple such entries if the device has more than one network interface.
          * For example: Device.Hosts.Host.1,Device.Hosts.Host.5
          * @version 1.0
          */
          %read-only string Host {
            on action validate call check_maximum 1024;
          }
      }

      /**
      * Parameters related to CPE behavior in order to issue a Heartbeat event to the ACS using the Inform method call.
      *
      * If this object is supported then the CPE MUST support the requirements of [Annex O/TR-069].
      *
      * @version 8.2
      */
      %persistent object HeartbeatPolicy {
          /**
          * When true, Heartbeat events are enabled to be sent to the ACS based on the values of the ReportingInterval and InitiationTime parameters.
          *
          * @version 8.2
          */
          %persistent bool Enable {
            default false;
            userflags %upc;
          }

          /**
          * The duration in seconds of the interval for which the CPE MUST attempt to connect with the ACS and call the Inform method if Enable is true.
          *
          * @version 8.2
          */
          %persistent uint32 ReportingInterval {
              on action validate call check_minimum 30;
              default 900;
          }

          /**
          * An absolute time reference in UTC to determine when the CPE will initiate the Heartbeat event Inform method calls. Each Inform call MUST occur at this reference time plus or minus an integer
          * multiple of the ReportingInterval.
          *
          * InitiationTime is used only to set the phase of the Heartbeat event Informs. The actual value of InitiationTime can be arbitrarily far into the past or future.
          *
          * For example, if ReportingInterval is 60 (one minute) and if InitiationTime is set to UTC midnight on some day (in the past, present, or future) then Heartbeat Informs will occur every minute at the
          * next UTC midnight. These MUST begin on the very next midnight, even if InitiationTime refers to a day in the future.
          *
          * The Unknown Time value defined in [Section 3.2/TR-106] indicates that no particular time reference is specified. The CPE MUST locally choose a random time reference.
          *
          * If absolute time is not available to the CPE, its Heartbeat Inform behavior MUST be the same as if the InitiationTime parameter was set to the Unknown Time value.
          *
          * @version 8.2
          */
          %persistent datetime InitiationTime;
      }

      /**
        * Object containing informations about connection request
        */
        %persistent %protected object ConnRequest {
          /**
            * The connection request host name, may be an ip address, this parameter thould be updated by a service like NetModeConfig when a new WAN IP address is available
            * @version 1.0
            */
            string ConnRequestHost {
                default "0.0.0.0";
            }

          /**
            * The local interface ip address.
            * For HGW this will typically contain the same value as ConnRequestHost
            * For devices on the lan this will be different from ConnRequestHost
            * @version 1.0
            */
            string LocalIPAddress {
                default "0.0.0.0";
            }

          /**
            * Update LocalIPAddress using either Interface parameters or nemo/netdev libraries
            */
          //TPB bool updateLocalIPAddress();

          /**
            * The connection request port
            * @version 1.0
            */
            %persistent uint32 ConnRequestPort {
                on action validate call check_range [0,65535];
                default 50805;
                userflags %upc;
            }

          /**
            * The connection request path
            * @version 1.0
            */
            %persistent string ConnRequestPath {
                default "default_path";
                userflags %upc;
            }

          /**
            * This parameter defines which connection request path will be used
            * - Fixed-Default: The path mentioned in the ConnRequestPath will be used, and will never change
            * - Random: At cwmpd startup, a new random path will be generated
            * - Randomize: At cwmpd startup and each time after a succesfull push, a new random path will be generated
            * - Fixed-MacBased: At cwmpd startup, a path will be constructed based on the MAC address
            * @version 1.0
            */
            %persistent string ConnRequestPathType {
                on action validate call check_enum ["Fixed-Default","Random","Randomize","Fixed-MacBased"];
                default "Random";
            }

          /**
            * Whether to update connectionRequestURL automatically or not
            * If true the ConnRequestURL is updated automatically.
            * @version 1.0
            */
            %read-only bool UpdateConnRequestURL {
                default true;
            }

          /**
            * whether to update connrequesthost automatically
            * @version 1.0
            */
            %read-only bool UpdateConnRequestHost {
                default true;
            }
      }

      /**
        * read-only internal CWMP parameters used to customize builds
        * @version 1.0
        */
        %persistent %protected object InternalSettings {
          /**
            * Datamodel that should be used
            * @version 1.0
            */
            %read-only string Datamodel {
                on action validate call check_enum ["TR098","TR106","TR181"];
                default "TR181";
            }

          /**
            * True : Always use the same ACS server IP.
            * False : Before contacting ACS, if the TTL in the DNS reply has expired, a new DNS request is sent.
            * Else, we continue to use the same ACS IP without sending a new DNS request.
            * @version 1.0
            */
            %persistent %read-only bool ACSIPAffinity=1;

          /**
            * Speficify the desired address family for the ACS URL resolution:
            *   - 0 indicates DNS should return socket addresses for any address family (either IPv4 or IPv6)
            *   - 4 IPv4 address family only
            *   - 6 IPv6 address family only
            */
            %persistent uint8 ACSAddrFamily=0;

          /**
            * To avoid booting all boxes at the same time and overloading the ACS on a power outage, cwmp waits for a random number of seconds before starting. This number defines the maximum startup delay that a box may have.
            * @version 1.0
            */
            %persistent uint32 MaxStartupDelay;

          /**
            * The session timeout timer value in seconds.
            * When the acs stops responding during a session, this timeout is used to stop the current ACS session and accept new incoming ACS sessions
            * @version 1.0
            */
            %persistent uint32 SessionTimeout;

          /**
            * This parameter changes the behavior of certificate verification:
            * if 0, self signed certificates will NOT be allowed
            * if 1, self signed certificates will be allowed
            * @version 1.0
            */
            %persistent bool SSLAcceptSelfSigned;

          /**
            * This parameter changes the behavior of certificate verification:
            * if 0, the host name in the certificate will NOT be checked
            * if 1, the host name in the certificate will be checked
            * @version 1.0
            */
            %persistent bool SSLVerifyHostname {
                default true;
            }

          /**
            * This parameter changes the behavior of certificate verification:
            * Never: never accept certificates that are not within the valid period
            * Always: Do NOT check the valid time of a certificate
            * NTP: Do NOT check when NTP is NOT synced, otherwise check the valid time of the certificate
            * @version 1.0
            */
            %persistent string SSLAcceptExpired {
                on action validate call check_enum ["Never", "Always", "NTP"];
                default "NTP";
            }

          /**
            * This parameter changes the behavior of certificate verification:
            * if 0, a full certificate chain verification is performed
            * if 1, a partial certificate chain verification is performed
            * A partial chain verification succeeds when at least one certificate
            * is in trusted store
            * @version 1.0
            */
            %persistent bool SSLVerifyPartialChain;

          /**
            * Number of seconds cwmpd has to wait before starting if there is an unfinished download in the message queue.
            * This parameter is used to avoid sending out 2 separate informs (one containing the boot event and the second the transfer complete)
            * @version 1.0
            */
            %persistent uint32 UpgradeBootDelay;

          /**
            * This parameter enables the GetRPCMethods RPC from CPE to ACS. This can be used to validate if the ACS supports all needed RPC's. This parameter is disabled by default.
            * If this parameter is false, the CPE will not check to see if the ACS method is supported before calling it.
            * @version 1.0
            */
            %persistent bool VerifySupportedACSMethods;

          /**
            * When this value is set, tr069 will only allow connection requests from the specified IP address (e.g. 195.186.0.5) or IP address range (e.g. 195.186.0.0/16)
            * This feature is only active when AllowConnectionRequestFromUnknownHost is set to true.
            * @version 1.0
            */
            %persistent string AllowConnectionRequestFromAddress {
                userflags %upc;
            }
          
          /**
            * Allow schedule inform per session
            * @version 1.0
            */
            bool AllowMultipleScheduleInform {
                default true;
            }

          /**
            * Maximum wait time between incoming ipv4 and ipv6 address for the WAN side of the box
            */
            %persistent uint32 IPv6WaitTime=0;

          /**
            * IPV4/IPV6 WAN mode:
            *   - IPV4: only use IPV4 as WAN address
            *   - IPV6PREFERRED: wait for IPV6 for IPv6WaitTime then use the available WAN address (IPv6 get the priority)
            *   - IPANY: use the first available WAN IP
            */
            %persistent string PreferredIPVersion {
              on action validate call check_enum ["IPV4ONLY","IPV6PREFERRED","IPANY"];
              default "IPANY";
            }

          /**
          * List of events send to the ACE  in the format eventtype(cmdkey),eventtype(cmdkey),eventtype(cmdkey),...
          * @version 1.0
          */
          string DeliveredEvents;

          /**
          * List of events requested by the ACS in the format eventtype(cmdkey),eventtype(cmdkey),eventtype(cmdkey),...
          * @version 7.0
          */
          string ACSEvents;

          /**
          * List of events to block in the format eventtype(cmdkey),eventtype(cmdkey),eventtype(cmdkey),...
          * @version 7.0
          */
          string BlockedEvents;

          /**
            * whether to inhibit the value change notification upon rebooting
            * @version 8.1
            */
          bool InhibitValueChangeUponBoot {
                default false;
          }
      }

      /**
        * object representing CWMP subscriptions
        * @version 1.0
        */
        %protected %persistent object Subscription[] {
           %protected %persistent %unique %key string Alias;
          /**
            * The subscription path
            * @version 1.0
            */
            %persistent string Path {
                userflags %upc;
            }
          /**
            * The type of subscription
            * @version 1.0
            */
            %persistent string Type {
                on action validate call check_enum ["Off","Passive","Active","Forced"];
                default "Off";
                userflags %upc;
            }
          /**
            * The value last set by the ACS
            * @version 1.0
            */
            %persistent string Value {
                userflags %upc;
            }
          /**
            * The override flag
            * @version 1.0
            */
            %persistent bool Override {
                userflags %upc;
            }
        }

      /**
        * This object provides the ACS with the ability to control the Parameters that are delivered by the Inform RPC.
        * @version 1.0
        */
        %persistent object InformParameter[] {
            counted with InformParameterNumberOfEntries;
          /**
            * Enables or disables this instance of InformParameter
            * @version 1.0
            */
            bool Enable {
                userflags %upc;
            }
          /**
            * A non-volatile handle used to reference this instance.
            * Alias provides a mechanism for an ACS to label this instance for future reference.
            * @version 1.0
            */
            %persistent %unique %key string Alias {
                userflags %upc;
            }
          /**
            * A pattern that describes the Parameter(s) to be included in the Inform’s ParameterList argument.
            * @version 1.0
            */
            %persistent string ParameterName {
                userflags %upc;
            }
          /**
            * Comma-separated list of strings.
            * Each entry in this list represents an Event for which this Parameter MUST be included within the ParameterList argument of the Inform RPC.
            * All Inform Events (see [Section 3.7.1.5/TR-069]), except for “4 VALUE CHANGE”, are allowed as entries in this list.
            * “4 VALUE CHANGE” is not allowed as that would violate requirements contained in [Section A.3.3.1/TR-069].
            * An empty string means all events except “4 VALUE CHANGE”.
            * @version 1.0
            */
            %persistent csv_string EventList {
                userflags %upc;
            }
          /**
            * Periodic Interval in seconds, that is required in order for this InformParameterList to be send.
            * When set to 0, this parameter will be ignored.
            * @version 1.0
            */
            %protected %persistent uint32 Interval {
                default 0;
                userflags %upc;
            }
          /**
            * Number of Inform messages on which this InformParameterList to be send.
            * When set to 0, this parameter will be ignored.
            * @version 1.0
            */
            %protected %persistent uint32 Count {
                default 0;
                userflags %upc;
            }
        }

   /**
    * This object contains all the ongoing 'transfers' (Downloads and uploads)
    * When an upload or download RPC is received from the ACS in cwmpd:
    * - a new entry is created with a description of the transfer.
    * - cwmp_plugin take the transfer data and invoke libfiletransfer to start the transfer
    * - Once finished, cwmp_plugin update the object state to 'Finished' and/or 'Error' ... 
    * - cwmpd will react on this change by sending a TransferComplete message to the ACS
    */
    %persistent %protected object ACSTransfers {
       /**
        * RPC to add a transfer
        * @version 1.0
        *
        * @param commandKey The command key
        * @param isDownload True if it is a download, false in case of upload
        * @param fileSize The file size
        * @param fileType The file type
        * @param url The url
        * @param userName The user name
        * @param password The password
        * @param targetFileName The target file name
        * @param successUrl The success url
        * @param failureURL The failure url
        * @param authentication the authentication strategy
        * @param caCertPath the CA certification file path
        * @param clientCertPath the Client certification file path
        * @param privatekeyPath the client private key file path
        *
        * @return true if succesfull, false if an error occurred
        **/
        bool AddTransfer(%in %mandatory string CommandKey, 
                          %in %mandatory bool IsDownload, 
                          %in %mandatory string Url,
                          %in %mandatory string FileType,
                          %in uint32 FileSize,  
                          %in string TargetFileName, 
                          %in string UserName, 
                          %in string Password);
          /**
        * object representing CWMP list of active transfers
        * @version 1.0
        */
        %persistent object ACSTransfer[] {
            %protected %persistent %unique %key string Alias;
          /**
            * Parameter indicating who started the transfer
            * ACS : transfer was requested by the ACS
            * Autonomous : transfer was started by cwmpd
            * @version 1.0
            */
            %persistent string Initiator {
                userflags %upc;
                on action validate call check_enum ["ACS","Autonomous"];
                default "ACS";
            }
          /**
            * ACS transfer request commandkey
            * @version 1.0
            */
            %persistent string CommandKey {
              userflags %upc;
            }
          /**
            * ACS Transfer Type (true if the transfer is download false otherwise)
            * @version 1.0
            */
            %persistent bool IsDownload {
              userflags %upc;
            }
          /**
            * Download or upload URL
            * @version 1.0
            */
            %persistent string Url {
              userflags %upc;
            }
           /**
            * A string describing the file type:
            *  Possible tr69 download strings:
            *   - 1 Firmware Upgrade Image
            *   - 2 Web Content
            *   - 3 Vendor Configuration File
            *   - 4 Tone File
            *   - 5 Ringer File
            *  Possible tr69 upload strings:
            *   - 1 Vendor Configuration File
            *   - 2 Vendor Log File
            * @version 1.0
            */
            %persistent string FileType {
                userflags %upc;
            }
            /**
            * Parameter indicating the current status of the transfer
            * @version 1.0
            */
            %persistent string Status {
                userflags %upc;
                on action validate call check_enum ["Initial","Applying","Finished"];
                default "Initial";
            }
          /**
            * Parameter indicating the file size
            * @version 1.0
            */
            %persistent uint32 FileSize {
              userflags %upc;
            }
          /**
            * Parameter indicating the file name
            * @version 1.0
            */
            %persistent string TargetFileName {
              userflags %upc;
            }
          /**
            * Parameter indicating the downloaded file name on the system
            * @version 1.0
            */
            %persistent string SaveFileName {
              userflags %upc;
            }
          /**
            * username for download authentication
            * @version 1.0
            */
            %persistent string Username {
              userflags %upc;
            }
          /**
            * password for download authentication
            * @version 1.0
            */
            %persistent string Password {
              userflags %upc;
            }
            /**
            * Transfer real Start Time
            * @version 1.0
            */
            %persistent datetime StartTime {
              userflags %upc;
            }
            /**
            * Transfer real complete time
            * @version 1.0
            */
            %persistent datetime CompleteTime {
              userflags %upc;
            }
            /**
            * Transfer Fault code
            * @version 1.0
            */
            %persistent uint32 FaultCode {
              userflags %upc;
            }

            /**
            * Transfer Fault error 
            * @version 1.0
            */
            %persistent string FaultString {
              userflags %upc;
            }

            /**
            * TR069 Transfer SuccessURL
            * @version 1.0
            */
            %persistent string SuccessURL {
              userflags %upc;
            }

            /**
            * TR069 Transfer FailureURL
            * @version 1.0
            */
            %persistent string FailureURL {
              userflags %upc;
            }

            /**
            * delay before start the transfer
            * @version 1.0
            */
            %persistent uint32 DelaySeconds {
              userflags %upc;
            }

            /**
            * Unique identifier for the subscription on the transfer node
            * @version 1.0
            */
            %persistent int32 SubscriptionId {
              userflags %upc;
            }
        }
    }
      /**
        * Parameters indicating the state of the ManagementServer
        */
        %persistent %protected object State {
          /**
            * Flag indicating that a factory reset has occurred. Once the CPE has succesfully send an inform message this flag will be set to 1. This flag will be reset to 0 when a factory reset occurs. Formerly known as FactoryResetOccurred
            * @version 1.0
            */
            %persistent bool BootstrapSent=0;

          /**
            * This parameter keeps track of the last succesfull session with the ACS
            * @version 1.0
            */
            %persistent datetime LastSession {
                userflags %upc;
            }

          /**
            * Parameter to indicate the reboot was caused by the ACS.
            * @version 1.0
            */
            %persistent bool RebootByACS=0;

          /**
            * Parameter to keep track of the reboot command key set by the ACS across reboots
            * @version 1.0
            */
            %persistent string RebootCommandKey {
                userflags %upc;
            }

          /**
            * This parameter displays if the CPE tr69 engine is in session (busy) or waiting for an event (idle) or still not initialized (Initializing)
            * it displays also session failure when ACS server is not reachable
            * @version 1.0
            */
            string SessionStatus {
                on action validate call check_enum ["Initializing","Idle","Busy","ServerDown"];
                default "Initializing";
            }

          /**
            * The ACS IP currently used to contact ACS
            * @version 1.0
            */
            %persistent string ACSIP;

          /**
            * List of ACS IPs returned by DNS service
            * @version 1.0
            */
            string ACSIPList;

          /**
            * The remaining time before TTL expiration.
            * 0 means that the TTL is expired.
            * -1 means that the TTL is unknown.
            * @version 1.0
            */
            %read-only int32 ACSIPTTL {
                default -1;
            }
        }

      /**
        * Object containing statistics
        */
        %protected object Stats {
          /**
            * Number of GetParameterValues requests that have occurred since reboot
            * @version 1.0
            */
            uint32 GetParameterValuesRequests=0;

          /**
            * Number of succesfull sessions with ACS since reboot
            * @version 1.0
            */
            uint32 SessionsSinceReboot=0;
          /**
            * Number of unsuccesfull delivered inform since reboot
            * @version 1.0
            */
            %read-only uint32 InformFailureCount=0;
        }

      /**
        * All requested ScheduleDownload transfers
        * @version 1.0
        */
      %persistent %protected object Transfers {
          /**
            * ScheduleDownload transfer used to download a specified file from the designated location and apply it within
            * either one or two specified time windows
            * @version 1.0
            */
          %persistent object ScheduleDownload[] {
              %protected %persistent %unique %key string Alias;
              on action del-inst call scheduleDownload_del_inst;
              counted with NumberOfScheduleDownloadEntries;

            /**
              * The string the CPE uses to refer to a particular download
              * @version 1.0
              */
              %persistent string CommandKey {
                  userflags %upc;
              }
              /**
                * An integer followed by a space followed by the file type description
                * @version 1.0
                */
              %persistent string FileType {
                  userflags %upc;
              }
              /**
                * URL specifying the source file location
                * @version 1.0
                */
              %persistent string URL {
                  userflags %upc;
              }
              /**
                * Username to be used by the CPE to authenticate with the file server.
                * @version 1.0
                */
              %persistent string Username {
                  userflags %upc;
              }
              /**
                * Password to be used by the CPE to authenticate with the file server.
                * @version 1.0
                */
              %persistent string Password {
                  userflags %upc;
              }
              /**
                * The size of the file to be downloaded in bytes.
                * @version 1.0
                */
              %persistent uint32 FileSize {
                  userflags %upc;
              }
              /**
                * The name of the file to be used on the target file system
                * @version 1.0
                */
              %persistent string TargetFileName {
                  userflags %upc;
              }
              /**
                * defines the time window(s) during which the CPE MUST perform and apply the download.
                * @version 1.0
                */
              %persistent object TimeWindowList[2] {
                  %protected %persistent %unique %key string Alias;
                  /**
                    * Status of the TimeWindow (Idle, Started, Ended)
                    * @version 1.0
                    */
                  %persistent string Status {
                      default "Idle";
                      userflags %upc;
                  }
                  /**
                    * Start of this time window in seconds
                    * @version 1.0
                    */
                  %persistent uint32 WindowStart {
                      userflags %upc;
                  }
                  /**
                    * End of this time window in seconds
                    * @version 1.0
                    */
                  %persistent uint32 WindowEnd {
                      userflags %upc;
                  }
                  /**
                    * Mode of the time window
                    * @version 1.0
                    */
                  %persistent string WindowMode {
                      userflags %upc;
                  }
                  /**
                    * A message to the user of the CPE, to inform him about a download request
                    * @version 1.0
                    */
                  %persistent string UserMessage {
                      userflags %upc;
                  }
                  /**
                    * The maximum number of retries for downloading and/or applying
                    * the file before regarding the transfer as having failed
                    * @version 1.0
                    */
                  %persistent int32 MaxRetries {
                      userflags %upc;
                  }
              }
              /**
                * TransferComplete associated with the ScheduleDownload Transfer.
                * Gives indication about the transfer status.
                * @version 1.0
                */
              %persistent object TransferComplete {
                  /**
                    * Status of the TransferComplete (Idle, In Progress, Failed, Done)
                    * @version 1.0
                    */
                  %persistent string Status {
                      userflags %upc;
                  }
                  /**
                    * The initiator of the ScheduleDownload transfer
                    * @version 1.0
                    */
                  %persistent string Initiator {
                      userflags %upc;
                  }
                  /**
                    * The string the CPE uses to refer to a particular download
                    * @version 1.0
                    */
                  %persistent string CommandKey {
                      userflags %upc;
                  }
                  /**
                    * Indicates the TransferComplete type
                    * @version 1.0
                    */
                  %persistent string TransferType {
                      userflags %upc;
                  }
                  /**
                    * Numerical fault code, 0 indicates no fault
                    * @version 1.0
                    */
                  %persistent uint32 FaultCode {
                      userflags %upc;
                  }
                  /**
                    * A human-readable text description of the fault
                    * @version 1.0
                    */
                  %persistent string FaultString {
                      userflags %upc;
                  }
                  /**
                    * The date and time transfer was started in UTC, or Unknown time
                    * @version 1.0
                    */
                  %persistent datetime StartTime {
                      userflags %upc;
                  }
                  /**
                    * The date and time the transfer was fully completed and applied in UTC, or Unknown time
                    * @version 1.0
                    */
                  %persistent datetime CompleteTime {
                      userflags %upc;
                  }
              }
          }

          /**
            * RPC used to add and perform a ScheduleDownload transfer
            * @version 1.0
            *
            * @param Initiator The initiator of the RPC call
            *
            * @param CommandKey The string the CPE uses to refer to a particular download, only "1 Firmware Upgrade Image" file type is supported.
            *
            * @param FileType An integer followed by a space followed by the file type description.
            *
            * @param URL URL specifying the source file location
            *
            * @param Username Username to be used by the CPE to authenticate with the file server.
            *
            * @param Password Password to be used by the CPE to authenticate with the file server.
            *
            * @param FileSize The size of the file to be downloaded in bytes.
            *
            * @param TargetFileName The name of the file to be used on the target file system
            *
            * @param TimeWindowList is a list, composed one or two time window(s) during which the CPE MUST perform and apply the download.
            * each time window is composed of: WindowStart, WindowEnd, WindowMode, UserMessage, MaxRetries.
            * with:
            *   WindowStart : is an uint32, representing the start of this time window in seconds
            *   WindowEnd   : is an uint32, representing the end of this time window in seconds
            *   WindowMode  : is a string, representing the mode of the time window, only "1 At Any Time" and "2 Immediately" modes are supported
            *   UserMessage : is a string, is a message to the user of the CPE, to inform him about a download request
            *   MaxRetries  : is an int32, is the maximum number of retries for downloading and/or applying the file before regarding,
            *                 the transfer as having failed. a value lower than 0 means, that the CPE will determines the number of retry.
            *
            * @return 0 on success or a fault code (9000,9001, ..) as specified in TR-069 on failure
            *
            */
          uint32 addScheduleDownload(%in %mandatory string Initiator,
                                   %in %mandatory string CommandKey,
                                   %in %mandatory string FileType,
                                   %in %mandatory string URL,
                                   %in string Username = "",
                                   %in string Password = "",
                                   %in %mandatory uint32 FileSize,
                                   %in string TargetFileName = "",
                                   %in %mandatory list TimeWindowList);
      }

      /**
      *  The connection request methods supported.
      *
      * @version 8.4
      */
      %persistent %read-only csv_string SupportedConnReqMethods {
        default "HTTP";
      }

      /**
      *  The Path Name of the XMPP.Connection instance that is used for connection requests to this ManagementServer.
      *
      * @version 8.4
      */
      %persistent string ConnReqXMPPConnection {
        default "";
      }

      /**
      *  List of Jabber IDs, or addresses, that are allowed to initiate an XMPP Connection Request.
      *
      * @version 8.4
      */
      %persistent csv_string ConnReqAllowedJabberIDs {
        default "";
      }

      /**
      *  The XMPP.Connection.{i}.JabberID contained in the XMPP.Connection instance referenced by the ConnReqXMPPConnection parameter.
      *
      * @version 8.4
      */
      %read-only string ConnReqJabberID {
        default "";
      }

      /**
      * Send an Inform with a list of events.
      * @param events: List of events to be sent within the Inform.
      * @param immediately: When true, if the CPE is not currently in a session with the ACS, the Inform will be sent immediately,
               otherwise, the Inform will be sent once the current session terminates.
               When false, the events will be queued, and will be delivered on a subsequent Inform (e.g., PERIODIC, VALUE CHANGE).
      * @param source: The initiator of the @ref sendInformMessage (e.g., XMPP).
      * @return void
      *
      * @version 8.4
      */
      void sendInformMessage(%in %mandatory csv_string events, %in %mandatory bool immediately, %in %mandatory string source);

      /**
      *  SMM: Software Module Management
      *
      * @version 1.0
      */
      %protected %persistent object SMM {
        %protected %persistent %read-only string Mapping;
        uint32 changeDUState(%in %mandatory string Initiator, %in %mandatory string CommandKey, %in %mandatory list Operations);
        object DUStateChangeComplete[] {
          %protected %unique %key string Alias;
          counted with NumberOfDUStateChangeCompleteEntries;
          /**
          * Status of the changeDUState (Idle, In Progress, Failed, Done)
          * @version 1.0
          */
          string Status;
          string Initiator;
          string CommandKey;
          object Operations[] {
            %protected %unique %key string Alias;
            counted with NumberOfOperations;
            string Type;
            string Status;
            uint32 ID;
            string URL;
            string UUID;
            string Username;
            string Password;
            string ExecutionEnvRef;
            string Version;

            object Results [] {
              %protected %unique %key string Alias;
              string UUID;
              string DeploymentUnitRef;
              string Version;
              string CurrentState;
              bool Resolved;
              string ExecutionUnitRefList;
              datetime StartTime;
              datetime CompleteTime;
              uint32 FaultCode;
              string FaultString;
            }
          }
        }
      }

      /**
        * The Mapping object is used to establish a translation rule that applies when the ACS utilizes GPA, GPV, or GPA RPCs.
        * - For GPN and GPV, the ParameterPath will be translated.
        * - For GPA, the Name will be translated.
        * This translation occurs in a single direction, from the ACS to the CPE.
        * @version 1.0
        */
      %protected %persistent object Mapping[] {
          /**
            * Alias of the mapping instance.
            * @version 1.0
            */
            %protected %persistent %unique %key string Alias {
                userflags %upc;
            }
          /**
            * The source path that will be translated
            * @version 1.0
            */
            %protected %persistent string Src {
                userflags %upc;
            }
          /**
            * The destination path that will be translated into
            * @version 1.0
            */
            %protected %persistent string Dst {
                userflags %upc;
            }
      }
    }
}

%populate {
    on event "dm:object-changed" call connreq_xmpp_connection_changed
        filter 'path matches "ManagementServer." && contains("parameters.ConnReqXMPPConnection")';

    on event "dm:object-changed" call schedule_download_transfer_failed
        filter 'path matches "ManagementServer.Transfers.ScheduleDownload.*.TransferComplete." &&
                parameters.Status.to == "Failed"';

    on event "dm:object-changed" call timewindow_started
        filter 'path matches "ManagementServer.Transfers.ScheduleDownload.*.TimeWindowList.*." &&
                parameters.Status.to == "Started"';

    on event "dm:object-changed" call timewindow_ended
        filter 'path matches "ManagementServer.Transfers.ScheduleDownload.*.TimeWindowList.*." &&
                parameters.Status.to == "Ended"';

    on event "dm:instance-added" call scheduleDownload_added
        filter 'path == "ManagementServer.Transfers.ScheduleDownload."';

    on event "dm:object-changed" call dscc_op_done
        filter 'path matches "ManagementServer.SMM.DUStateChangeComplete.*.Operations.*." &&
                parameters.Status.to == "Done"';

    on event "app:stop" call app_stopped;
}

