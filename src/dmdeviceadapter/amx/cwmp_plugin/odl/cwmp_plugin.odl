%config {
    name = "cwmp_plugin";
    import-dbg = true;

    // SAHTRACE
    sahtrace = {
        type = "syslog",
        level = 200
    };

    // main files
    definition_file = "${name}-definition.odl";
    defaults_file = "${name}-defaults.odl";
    save_file = "${rw_data_path}/${name}/odl/${name}.odl";
    
    // Use ODL persistent storage
    storage-type = "odl";
    storage-path = "${rw_data_path}/${name}/";
    %global odl = {
        dm-load = true,
        dm-save = true,
        dm-save-on-changed = true,
        dm-save-delay = 1000,
        dm-defaults = "${defaults_file}",
        directory = "${storage-path}/odl"
    };

    tr069-service = {
        // Path where to store temporary values for RPC's that need to survive a reboot
        cwmpd_persistent_rpc_path = "/etc/config/cwmp_plugin",
        cwmpd_pid_file = "/var/run/cwmp.pid",
        cwmpd_certs_file = "/usr/lib/cwmp/cwmpdcerts.pem",
        cwmpd_adapter_path = "/usr/lib/libdmda_amx.so"
    };

    firewall = {
        controller = "/usr/lib/amx/modules/mod-fw-amx.so"
    };

    odl_config = "${cfg-dir}/${name}/${name}.odl";
    backends = ["/usr/bin/mods/amxb/mod-amxb-ubus.so"];

    trace-zones = {
        CWMP_PLUGIN = 200,
        CWMPD = 200,
        DM_DA = 200,
        DM_ENGINE = 200,
        DM_COM = 200,
        DM_COMMON = 200,
        DM_HS = 200
    };
}

#include "${name}-${storage-type}.odl";

import "${name}.so" as "${name}";
#include "mod_sahtrace.odl";

include "${definition_file}";
include "${defaults_file}";

requires "Device.";
requires "DeviceInfo.";
requires "Time.";
requires "NetModel.Intf.";
requires "Firewall.";

%define {
    entry-point cwmp_plugin.cwmp_plugin_main;
}

%populate {
    on event "dm:object-changed" call updateConnectionRequestURL
        filter 'path == "ManagementServer.ConnRequest." && (contains("parameters.ConnRequestHost") || contains("parameters.ConnRequestPort") || contains("parameters.ConnRequestPath"))';
    on event "dm:object-changed" call writeInterface
        filter 'path == "ManagementServer." && contains("parameters.Interface")';
}
