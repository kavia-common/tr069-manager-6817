%define {
    object Device {
        object GSDMCheck {
            object Client []{
                counted with ClientNumberOfEntries;
            }
            object Server {
                bool Enable;
                object Pool[]{
                    counted with PoolNumberOfEntries;
                    bool Enable;
                    string Status;
                    object Client []{
                        counted with ClientNumberOfEntries;
                        string Alias;
                        object Option []{
                            counted with OptionNumberOfEntries;
                            uint8 Tag;
                            string Value;
                        }
                    }
                }
            }
        }
        object TypeCheck {
            int8 P_i8 = -8;
            int16 P_i16 = -16;
            int32 P_i32 = -32;
            int64 P_i64 = -64;
            uint8 P_ui8 = 8;
            uint16 P_ui16 = 16;
            uint32 P_ui32 = 32;
            uint64 P_ui64 = 64;
            string P_s = "string";
            csv_string P_s_csv = "csv,string";
            ssv_string P_s_ssv = "ssv string";
            datetime P_d;
            bool P_b = true;
        }
        object Bridging {
            object Bridge[] {
                object Port[] {
                    string LowerLayers;
                    object Stats {
                        uint32 BytesReceived;
                        uint32 BytesSent;
                        uint32 PacketsReceived;
                        uint32 PacketsSent;
                    }
                    string Status;
                }
            }
        }
        object DeviceInfo {
            string HardwareVersion;
            string Manufacturer;
            string ModelNumber;
            string SoftwareVersion;
            uint32 UpTime;
        }
        object DHCPv4 {
            object Server {
                object Pool[] {
                    bool Enable;
                    string MaxAddress;
                    string MinAddress;
                    string SubnetMask;
                }
            }
        }
        object DNS {
            object Client {
                object Server[] {
                    string DNSServer;
                    bool Enable;
                }
            }
        }
        object Ethernet {
            object Interface[] {
                uint32 CurrentBitRate;
                string DuplexMode;
                int32 MaxBitRate;
                bool Upstream;
            }
            object Link[] {
                string Alias;
                bool Enable;
                bool FlowControl;
                uint32 LastChange;
                string LowerLayers;
                string MACAddress;
                string Name;
                bool NoARP;
                bool PriorityTagging;
                object Stats {
                    uint32 BroadcastPacketsReceived;
                    uint32 BroadcastPacketsSent;
                    uint32 BytesReceived;
                    uint32 BytesSent;
                    uint32 DiscardPacketsReceived;
                    uint32 DiscardPacketsSent;
                    uint32 ErrorsReceived;
                    uint32 ErrorsSent;
                    uint32 MulticastPacketsReceived;
                    uint32 MulticastPacketsSent;
                    uint32 PacketsReceived;
                    uint32 PacketsSent;
                    uint32 UnicastPacketsReceived;
                    uint32 UnicastPacketsSent;
                    uint32 UnknownProtoPacketsReceived;
                }
                string Status;
            }
        }
        object Hosts {
            uint32 HostNumberOfEntries;
            object Host[] {
                string IPAddress;
                string PhysAddress;
                string HostName;
                object IPv4Address[] {
                    string IPAddress;
                }
                object IPv6Address[] {
                    string IPAddress;
                }
                string Layer1Interface;
                string InterfaceType;
                bool Active;
                object X_VZ-COM {
                    int32 DeviceClass;
                    int32 DeviceFirmware;
                    uint32 DeviceIconId;
                    int32 DeviceLocation;
                    int32 DeviceManufacturer;
                    int32 DeviceMobility;
                    int32 DeviceModel;
                    int32 DeviceOS;
                    int32 DeviceProduct;
                    int32 DeviceSubmodel;
                    string HalfDayDownload;
                    string HalfDayUpload;
                    int32 MACVendor;
                    string OneDayDownload;
                    string OneDayUpload;
                    string OneHourDownload;
                    string OneHourUpload;
                    string OneMonthDownload;
                    string OneMonthUpload;
                    string OneWeekDownload;
                    string OneWeekUpload;
                    bool Persistent;
                    string TimeOnNetwork;
                }
                string X_VZ-COM_DeviceName;
                int32 AssociatedDevice;
            }
        }
        object IP {
            object Interface[] {
                string Alias;
                bool AutoIPEnable;
                bool Enable;
                object IPv4Address[] {
                    string AddressingType;
                    string Alias;
                    bool Enable;
                    string IPAddress;
                    string Status;
                    string SubnetMask;
                }
                uint32 IPv4AddressNumberOfEntries;
                bool IPv4Enable;
                object IPv6Address[] {
                    string Alias;
                    bool Anycast;
                    bool Enable;
                    string IPAddress;
                    string IPAddressStatus;
                    string Origin;
                    datetime PreferredLifetime;
                    string Prefix;
                    string Status;
                    datetime ValidLifetime;
                }
                uint32 IPv6AddressNumberOfEntries;
                bool IPv6Enable;
                uint32 IPv6PrefixNumberOfEntries;
                uint32 LastChange;
                bool Loopback;
                string LowerLayers;
                uint32 MaxMTUSize;
                string Name;
                bool Reset;
                string Router;
                object Stats {
                    uint32 BroadcastPacketsReceived;
                    uint32 BroadcastPacketsSent;
                    uint32 BytesReceived;
                    uint32 BytesSent;
                    uint32 DiscardPacketsReceived;
                    uint32 DiscardPacketsSent;
                    uint32 ErrorsReceived;
                    uint32 ErrorsSent;
                    uint32 MulticastPacketsReceived;
                    uint32 MulticastPacketsSent;
                    uint32 PacketsReceived;
                    uint32 PacketsSent;
                    uint32 UnicastPacketsReceived;
                    uint32 UnicastPacketsSent;
                    uint32 UnknownProtoPacketsReceived;
                }
                string Status;
                string Type;
                bool ULAEnable;
                string X_PRPL-COM_Description;
                object X_PRPL-COM_IPv4Config {
                    uint32 NeighborReachableTime;
                }
                object X_PRPL-COM_IPv6Config {
                    uint32 NeighborReachableTime;
                }
                string X_PRPL-COM_MTUMode;
                object IPv6Prefix[] {
                    string Alias;
                    bool Autonomous;
                    string ChildPrefixBits;
                    bool Enable;
                    bool OnLink;
                    string Origin;
                    string ParentPrefix;
                    datetime PreferredLifetime;
                    string Prefix;
                    string PrefixStatus;
                    string StaticType;
                    string Status;
                    datetime ValidLifetime;
                }
            }
            bool IPv6Enable;
            string IPv6Status;
        }
        object MoCA {
            object Interface[] {
                bool AccessControlEnable;
                uint32 AccessControlNumberOfEntries;
                uint32 AeNumber;
                uint32 AggregationSize;
                string Alias;
                uint32 AssociatedDeviceNumberOfEntries;
                bool AvbSupport;
                uint32 BackupNC;
                string Band;
                int32 BeaconPowerDistributed;
                uint32 BeaconPowerLimit;
                int32 BeaconPowerLocal;
                int32 BeaconPowerMePie;
                bool BeaconPowerMePieSend;
                bool BeaconPowerNetConfig;
                uint32 BridgeNumberOfEntries;
                bool ConnectedNodesChangeTrapEn;
                int32 ConnectedNodesDropReason;
                int32 ConnectedNodesInfo;
                uint32 CurrentOperFreq;
                string CurrentVersion;
                bool Enable;
                string FirmwareVersion;
                int32 FirstOffset;
                int32 FreqCapabilityMask;
                int32 FreqCurrentMask;
                int32 FreqCurrentMaskSetting;
                bool HandoffToLowerVersionEnable;
                string HighestVersion;
                int32 KeyPassphrase;
                uint32 LastChange;
                uint32 LastOperFreq;
                bool LastOperFreqUpdateEnable;
                uint32 LinkDownCount;
                string LinkState;
                uint32 LmoNodeID;
                bool LmoTrapEnable;
                int32 LowerLayers;
                string MACAddress;
                uint32 MaxBitRate;
                uint32 MaxEgressBW;
                uint32 MaxIngressBW;
                bool MaxNodes;
                uint32 MeshNumberOfEntries;
                uint32 MeshScModNumberOfEntries;
                uint32 MgntEntityNetIePayloadRespTimeout;
                int32 MgntEntityNetIePayloadRx;
                int32 MgntEntityNetIePayloadTx;
                bool MgntEntityNetwIePayloadRecTrapEn;
                bool Moca25PhyCapable;
                int32 MpsInitScanPayload;
                bool MpsPrivacyDown;
                bool MpsPrivacyReceive;
                bool MpsReset;
                bool MpsState;
                bool MpsTrapEn;
                bool MpsTriggered;
                uint32 MpsUnpairedTime;
                uint32 MpsWalkTime;
                string Name;
                bool NcPrivSupportedRecTrapEn;
                int32 NcVersion;
                uint32 NetworkCoordinator;
                bool NetworkJoin;
                string NetworkNameAdmissionRule;
                int32 NetworkNameNcNn;
                int32 NetworkNamePayload;
                bool NetworkNameRecTrapEn;
                string NetworkState;
                string NetworkTabooMask;
                bool NodeDropTrapEn;
                uint32 NodeID;
                string NodeTabooMask;
                uint32 NumChannels;
                uint32 NumNodes;
                bool NumNodesChangeEnable;
                uint32 PacketAggregationCapability;
                uint32 Per25Mode;
                uint32 PerMode;
                uint32 PhyThreshold;
                bool PhyThresholdTrapEnable;
                bool PolicingEnable;
                uint32 PowerCntlPhyTarget;
                string PowerStateCap;
                string PowerStateRequest;
                bool PowerStateResp;
                int32 PowerStateStatus;
                bool PowerStateTrapEnable;
                bool PreferredNC;
                int32 PrimaryChannelOffset;
                int32 PrimaryOffset;
                bool PrivacyEnabled;
                bool PrivacyEnabledSetting;
                int32 PrivacyNc;
                string PrivacySupported;
                bool QAM256Capable;
                uint32 ResetCount;
                string ResetReason;
                bool RlapmEnable;
                uint32 RlapmNumberOfEntries;
                uint32 RlapmProfileSelect;
                bool SapmEnable;
                uint32 SapmNumberOfEntries;
                uint32 SapmProfileSelect;
                int32 SecondaryChannelOffset;
                int32 SecondaryOffset;
                uint32 SeqNumMr;
                string Status;
                bool StatusChangeEnable;
                string SupportedBands;
                uint32 SupportedEgressPqosFlows;
                uint32 SupportedIngressPqosFlows;
                uint32 TlpMax;
                uint32 TlpMin;
                bool TpcEnable;
                uint32 TpcTargetRateNper;
                string TrafficPermissionEthertype;
                int32 TrafficPermissionLink;
                bool TurboModeEnable;
                uint32 TxBcastPowerReduction;
                uint32 TxBcastRate;
                uint32 TxPowerLimit;
                bool Upstream;
                string X_PRPL-COM_Description;
                uint32 X_PRPL-COM_MTU;
                string X_PRPL-COM_MTUMode;
                object AssociatedDevice[] {
                    bool Active;
                    uint32 AeNumber;
                    uint32 AggregationSize;
                    bool BondingCapable;
                    uint32 EgressNodeNumFlows;
                    bool EnhancedPrivacyCapable;
                    int32 HighestVersion;
