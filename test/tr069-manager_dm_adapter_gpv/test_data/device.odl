                    int32 LinkType;
                    int32 MACAddress;
                    bool Moca25PhyCapable;
                    uint32 NodeID;
                    int32 PDelay;
                    uint32 PHYRxRate;
                    uint32 PHYTxRate;
                    uint32 PacketAggregationCapability;
                    int32 PowerState;
