#!/usr/bin/amxrt

%config {
    // Application name
    name = "test_dm";

    uris = ["pcb:/tmp/test.sock"];
    backends = ["/usr/bin/mods/amxb/mod-amxb-pcb.so"];

    // amxrt config-options
    auto-detect = false;
    auto-connect = true;
    daemon = false;
    priority = 0;
}





%define {
    object Device {
        %read-only string RootDataModelVersion = "2.14";
        %read-only object InterfaceStack[] {
            counted with InterfaceStackNumberOfEntries;
            string data;
        }

        object ManagementServer {
            bool EnableCWMP =1;
            string Username = "cdrouter";
            uint32 PeriodicInformInterval=10000;
            bool InstanceWildcardsSupported=1;
            bool ReturnEmptyListOnPartialPath=1;
            string ParameterKey = "randomkey";
            bool VerifyParameterType =1;

            object InternalSettings {
                string Datamodel = "TR181";
                uint32 ReturnEmptyListOnPartialPath = 1;
            }
            object ConnRequest {
                string ConnRequestHost="0.0.0.0";
                %read-only string ConnectionRequestURL="http://test-readonly-url";
            }
            object State {
                string SessionStatus="test";
                bool RebootByACS =0;
                bool FactoryResetOccurred = 0;
                string RebootCommandKey = "reboot";
                bool BootstrapSent = 1;
            }
            object Stats {
                uint32 GetParameterValuesRequests = 0;
            }
        }

        object GetParameterNames_Parameter {
            string writablestring="test";
            %read-only string readonlystring ="test-read-only";
        }

        object GetParameterNames_Object_NextLevel_True {
            string writablestring ="test";
            %read-only string readonlystring ="test-read-only";
            object GetParameterNames_Object1_NextLevel_True {
                string Username = "cdrouter";
            }
            object GetParameterNames_Object2_NextLevel_True {
                string Username = "cdrouter";
            }
        }

        object GetParameterNames_Object_NextLevel_False {
            %read-only string readonlystring ="test-read-only";
            int32 writableInteger =9999;
            string writablestring ="writable-string";
            object GetParameterNames_Object1{
                string test1 = "test";
            }
            object GetParameterNames_Object2{
                string test1 = "test";
            }
        }

        object GetParameter_Object_Sorted {
            string cccc ="test";
            int32 bbbb = 9999;
            string aaaa ="test";
            object GetParameter_Object2{
                string eeee = "test";
                string dddd = "test";
            }
            object GetParameter_Object1{
                string ffff = "test";
            }

            object GetParameter_Object3[] {
                string gggg;
            }
        }

        object SetParameterValues_Test_Object{
            int32 writableInteger =9999;
            string writablestring ="writable-string";
            %read-only string readonlystring ="test-read-only";
        }

        object Hosts {
            uint32 nbHosts=0;
            object Host[] {
                string MACAddress;
                string IPAddress;
            }
        }

        object DeviceInfo {
            string SerialNumber = "000000123";
            string DeviceStatus = "Up";
            string HardwareVersion = "1.1";
            string SoftwareVersion = "2.7";
            uint32 testuint = 10;
            int32 testint = 10;
            bool testbool=1;
        }

        object Time {
            bool Enable = 1;
            string Status = "Unsynchronized";
        }

        object NoAccessRights {
            string Status = "dummy";
        }

    }
}

%populate {
    object Device {
        object GetParameter_Object_Sorted {
            object GetParameter_Object3 {
                instance add(0) {
                    parameter gggg = "test1";
                }
                instance add(0) {
                    parameter gggg = "test2";
                }
                instance add(0) {
                    parameter gggg = "test3";
                }
                instance add(0) {
                    parameter gggg = "test4";
                }
                instance add(0) {
                    parameter gggg = "test5";
                }
                instance add(0) {
                    parameter gggg = "test6";
                }
                instance add(0) {
                    parameter gggg = "test7";
                }
                instance add(0) {
                    parameter gggg = "test8";
                }
                instance add(0) {
                    parameter gggg = "test9";
                }
                instance add(0) {
                    parameter gggg = "test10";
                }
                instance add(0) {
                    parameter gggg = "test11";
                }
            }
        }
    }
}
